<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="section" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Label text="Управление учетными записями" styleClass="section-title"/>
    <HBox spacing="14" styleClass="split-layout" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="loginColumn" text="Логин" prefWidth="120"/>
                    <TableColumn fx:id="fullNameColumn" text="ФИО" prefWidth="190"/>
                    <TableColumn fx:id="roleColumn" text="Роль" prefWidth="150"/>
                    <TableColumn fx:id="activeColumn" text="Активен" prefWidth="80"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="10" styleClass="side-panel">
            <Label text="Пользователь" styleClass="section-title"/>
            <GridPane hgap="10" vgap="8" styleClass="form-grid">
                <Label text="Логин" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="loginField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="ФИО" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="fullNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Пароль" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <PasswordField fx:id="passwordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Роль" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="roleBox" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="8" styleClass="toolbar">
                <Button text="Сохранить" onAction="#saveUser" styleClass="primary-button"/>
                <Button text="Новый" onAction="#clearForm" styleClass="secondary-button"/>
                <Button text="Блокировать/разблокировать" onAction="#toggleActive" styleClass="secondary-button"/>
                <Button text="Сменить пароль" onAction="#resetPassword" styleClass="secondary-button"/>
                <Button text="Удалить пользователя" onAction="#deleteUser" styleClass="danger-button"/>
            </FlowPane>
        </VBox>
    </HBox>
</VBox>
