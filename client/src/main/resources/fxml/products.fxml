<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="section" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Label text="Товары и складские остатки" styleClass="section-title"/>
    <HBox spacing="14" styleClass="split-layout" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Товар" prefWidth="190"/>
                    <TableColumn fx:id="articleColumn" text="Артикул" prefWidth="90"/>
                    <TableColumn fx:id="stockColumn" text="Остаток" prefWidth="80"/>
                    <TableColumn fx:id="categoryColumn" text="Категория" prefWidth="130"/>
                    <TableColumn fx:id="purchaseColumn" text="Закупка" prefWidth="90"/>
                    <TableColumn fx:id="retailColumn" text="Продажа" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
        <VBox fx:id="sidePanel" spacing="10" styleClass="side-panel">
            <Label fx:id="sideTitle" text="Карточка товара" styleClass="section-title"/>
            <GridPane fx:id="formGrid" hgap="10" vgap="8" styleClass="form-grid">
                <Label text="Название" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Артикул" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="articleField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Остаток" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="stockField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Закупочная цена" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="purchaseField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Розничная цена" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="retailField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Категория" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <ComboBox fx:id="categoryBox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>
            <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="8" styleClass="toolbar">
                <Button fx:id="saveButton" text="Сохранить" onAction="#saveProduct" styleClass="primary-button"/>
                <Button text="Новый" onAction="#clearForm" styleClass="secondary-button"/>
                <Button fx:id="deleteButton" text="Удалить" onAction="#deleteProduct" styleClass="danger-button"/>
            </FlowPane>
        </VBox>
    </HBox>
</VBox>
