<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="section" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Label text="Категории расходов" styleClass="section-title"/>
    <HBox spacing="14" styleClass="split-layout" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="categoriesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Категория" prefWidth="220"/>
                    <TableColumn fx:id="descriptionColumn" text="Описание" prefWidth="360"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="10" styleClass="side-panel">
            <Label text="Категория расходов" styleClass="section-title"/>
            <GridPane hgap="10" vgap="8" styleClass="form-grid">
                <Label text="Название" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Описание" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="descriptionField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            </GridPane>
            <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="8" styleClass="toolbar">
                <Button text="Сохранить категорию" onAction="#saveCategory" styleClass="primary-button"/>
                <Button text="Новая категория" onAction="#clearForm" styleClass="secondary-button"/>
                <Button text="Удалить категорию" onAction="#deleteCategory" styleClass="danger-button"/>
            </FlowPane>
        </VBox>
    </HBox>
</VBox>
