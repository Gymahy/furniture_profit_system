<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="section" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Label text="История логов" styleClass="section-title"/>
    <TableView fx:id="auditTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="timeColumn" text="Время" prefWidth="150"/>
            <TableColumn fx:id="userColumn" text="Пользователь" prefWidth="170"/>
            <TableColumn fx:id="actionColumn" text="Действие" prefWidth="190"/>
            <TableColumn fx:id="entityTypeColumn" text="Объект" prefWidth="120"/>
            <TableColumn fx:id="entityIdColumn" text="ID" prefWidth="70"/>
            <TableColumn fx:id="detailsColumn" text="Детали" prefWidth="260"/>
        </columns>
    </TableView>
</VBox>
