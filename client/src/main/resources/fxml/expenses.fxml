<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="section" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Label text="Операционные расходы" styleClass="section-title"/>
    <HBox spacing="14" styleClass="split-layout" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="8" styleClass="toolbar">
                <Label text="С"/>
                <DatePicker fx:id="startDatePicker"/>
                <Label text="По"/>
                <DatePicker fx:id="endDatePicker"/>
            </FlowPane>
            <TableView fx:id="expensesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="expenseDateColumn" text="Дата" prefWidth="100"/>
                    <TableColumn fx:id="amountColumn" text="Сумма" prefWidth="90"/>
                    <TableColumn fx:id="categoryColumn" text="Категория" prefWidth="140"/>
                    <TableColumn fx:id="descriptionColumn" text="Описание" prefWidth="260"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="10" styleClass="side-panel">
            <Label text="Регистрация расхода" styleClass="section-title"/>
            <GridPane hgap="10" vgap="8" styleClass="form-grid">
                <Label text="Дата" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <DatePicker fx:id="expenseDatePicker" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Сумма" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="amountField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Категория" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="categoryBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Описание" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="descriptionField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="8" styleClass="toolbar">
                <Button text="Сохранить расход" onAction="#saveExpense" styleClass="primary-button"/>
                <Button text="Новый расход" onAction="#clearExpense" styleClass="secondary-button"/>
                <Button text="Удалить расход" onAction="#deleteExpense" styleClass="danger-button"/>
            </FlowPane>
        </VBox>
    </HBox>
</VBox>
