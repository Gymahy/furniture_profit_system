<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" styleClass="section" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <Label text="Финансовые отчеты" styleClass="section-title"/>
    <FlowPane alignment="CENTER_LEFT" hgap="8" vgap="8" styleClass="toolbar">
        <ComboBox fx:id="reportTypeBox"/>
        <Label text="С"/>
        <DatePicker fx:id="startDatePicker"/>
        <Label text="По"/>
        <DatePicker fx:id="endDatePicker"/>
        <Button text="Сформировать" onAction="#buildReport" styleClass="primary-button"/>
        <Button text="Экспорт CSV" onAction="#exportReport" styleClass="secondary-button"/>
    </FlowPane>
    <VBox fx:id="reportBody" spacing="10" VBox.vgrow="ALWAYS">
        <TableView fx:id="reportTable" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
